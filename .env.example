# 이 파일을 복사해 `.env` 라는 이름으로 만든 뒤, = 뒤에 값을 채워 주세요.
# `.env` 는 .gitignore에 들어 있어 깃허브에 올라가지 않습니다.

# 텔레그램 BotFather에서 받은 토큰
TELEGRAM_BOT_TOKEN=

# 봇을 쓸 사람의 텔레그램 숫자 ID (이 사람 말고는 봇이 응답하지 않습니다)
TELEGRAM_ALLOWED_USER_ID=

# https://www.notion.so/my-integrations 에서 만든 통합의 토큰
NOTION_TOKEN=

# 학습 기록을 저장할 노션 표의 ID.
# 비워 두어도 됩니다 - 봇을 켠 뒤 텔레그램에서 /setup 을 보내면
# 접근할 수 있는 표를 버튼으로 보여 주고, 고른 값을 여기에 적어 줍니다.
NOTION_DB_ID=

# /export 결과를 모아 두는 추출본 표의 ID.
# 비워 두세요 - [노션에 저장]을 처음 누를 때 봇이 만들고 여기에 적습니다.
NOTION_EXPORT_DB_ID=
